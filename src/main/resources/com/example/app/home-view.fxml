<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.app.ui.HomeController"
      spacing="16"
      styleClass="page">

    <Label text="Welcome" styleClass="page-title"/>
    <Label text="A minimal shell with navigation, FXML views, CSS theming, and injected controllers. Replace this view with your own."
           styleClass="page-subtitle"
           wrapText="true"
           maxWidth="560"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="nameField"
                   promptText="Your name"
                   prefWidth="260"
                   onAction="#onGreet"/>
        <Button text="Greet"
                onAction="#onGreet"
                defaultButton="true"
                styleClass="primary-button"/>
    </HBox>

    <Label fx:id="greetingLabel" styleClass="greeting"/>
</VBox>
